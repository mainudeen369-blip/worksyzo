# Worksyzo environment
#
# Neon Console → Connection Details → copy connection string (single paste)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3001
SESSION_SECRET=change-me-to-a-long-random-string-please-32+
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# --- File storage -----------------------------------------------------------
# Primary (production): Cloudflare R2
#   STORAGE_DRIVER=r2
# Fallback (dev / air-gapped): local disk
#   STORAGE_DRIVER=local
#   STORAGE_LOCAL_DIR=D:\WorksyzoData\storage   (any absolute or relative path)
#
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage

# Cloudflare R2 (required when STORAGE_DRIVER=r2)
# Create bucket + API token in Cloudflare dashboard → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=speaklo-r2
# Optional override (default https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# R2_REGION=auto

REDIS_URL=redis://localhost:6380

LLM_PROVIDER=groq
GROQ_CHAT_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_CHAT_MODEL=openai/gpt-oss-120b
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
LLM_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

NEXT_PUBLIC_API_URL=http://localhost:4000

# 3D assistant avatar (.glb). Default: cartoon robot at apps/web/public/avatars/worksyzo-bot.glb
# Legacy human/minion models are ignored at runtime.
# NEXT_PUBLIC_AVATAR_GLB_URL=/avatars/worksyzo-bot.glb
